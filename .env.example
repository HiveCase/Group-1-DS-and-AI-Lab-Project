# Backend environment configuration.
# Copy this file to .env at the repository root (`cp .env.example .env`) and
# fill in real secret values there. Never commit a real .env -- it is
# already gitignored. Every placeholder below is fake; do not reuse it.

# --- Required to run the live app ---------------------------------------
# Signs/verifies the JWT issued by POST /auth/login. Defaults to an
# intentionally-insecure placeholder if unset -- set a real 32+ byte random
# value before any shared/production deployment.
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret

# --- Effectively required (the app runs without it, but degrades) -------
# Groq Cloud API key (https://console.groq.com). Powers report synthesis
# and the LangGraph coordinator's LLM planning. Without it, every claim
# gets a deterministic fallback report (report_json.is_fallback = true)
# instead of a real LLM assessment.
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Defaults to openai/gpt-oss-120b if unset (see backend/app/core/config.py).
MODEL_NAME=openai/gpt-oss-120b

# --- Optional: Langfuse observability (tracing is silently disabled if
# either key is absent) -----------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Optional: auth token lifetimes --------------------------------------
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Optional: storage locations -----------------------------------------
# All four default to absolute paths anchored under backend/ (see
# backend/app/core/config.py: DATABASE_URL -> backend/data/claims.db,
# UPLOAD_DIR -> backend/data/uploads, MODEL_DIR -> backend/models,
# DATA_DIR -> backend/data). Uncomment and set an absolute path only if you
# want to relocate them.
# DATABASE_URL=sqlite:////absolute/path/to/claims.db
# UPLOAD_DIR=/absolute/path/to/uploads
# MODEL_DIR=/absolute/path/to/models
# DATA_DIR=/absolute/path/to/data

# --- Optional: only needed to reproduce the RAG evaluation metrics
# (backend/app/rag_scripts/scripts/ragas_eval.py) -- Google AI Studio key
# for the gemini-2.5-flash judge model. Not read by the running app itself.
GOOGLE_API_KEY=your-google-api-key-here
