# Backend environment configuration
# Copy this file to .env and fill in any secret values.

# Database
DATABASE_URL=sqlite:///./data/claims.db
UPLOAD_DIR=uploads
MODEL_DIR=models
DATA_DIR=data

# Optional Langfuse observability settings
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Groq Cloud settings (report synthesis)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

